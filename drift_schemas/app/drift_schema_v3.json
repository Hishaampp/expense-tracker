      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"id\" TEXT NOT NULL, \"category_id\" TEXT NULL REFERENCES categories (id) ON DELETE CASCADE, \"amount_paise\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (amount_paise > 0), CHECK ((id = 'month' AND category_id IS NULL) OR (category_id IS NOT NULL AND id = 'category:' || category_id))) STRICT;"
