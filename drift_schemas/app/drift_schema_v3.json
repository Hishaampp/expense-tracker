  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"bank_code\" TEXT NULL, \"last4\" TEXT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (type IN ('bank', 'creditCard', 'cash', 'wallet'))) STRICT;"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (kind IN ('expense', 'income', 'system'))) STRICT;"
        }
      ]
    },
    {
      "name": "rooms",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rooms\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"emoji\" TEXT NULL, \"start_day\" INTEGER NULL, \"end_day\" INTEGER NULL, \"budget_paise\" INTEGER NULL, \"auto_tag_mode\" TEXT NOT NULL, \"counts_toward_monthly_budget\" INTEGER NOT NULL DEFAULT 0 CHECK (\"counts_toward_monthly_budget\" IN (0, 1)), \"status\" TEXT NOT NULL DEFAULT 'active', \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (type IN ('trip', 'wedding', 'event', 'custom')), CHECK (auto_tag_mode IN ('dateWindow', 'suggest', 'manual')), CHECK (status IN ('active', 'archived')), CHECK (budget_paise IS NULL OR budget_paise >= 0)) STRICT;"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"amount_paise\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'INR', \"occurred_at\" INTEGER NOT NULL, \"account_id\" TEXT NOT NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"to_account_id\" TEXT NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"category_id\" TEXT NULL REFERENCES categories (id) ON DELETE SET NULL, \"room_id\" TEXT NULL REFERENCES rooms (id) ON DELETE SET NULL, \"payee_key\" TEXT NULL, \"payee_display\" TEXT NULL, \"instrument\" TEXT NOT NULL, \"ref_no\" TEXT NULL, \"note\" TEXT NULL, \"review_status\" TEXT NOT NULL, \"is_hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_hidden\" IN (0, 1)), \"linked_transaction_id\" TEXT NULL, \"origin\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (amount_paise > 0), CHECK (kind IN ('expense', 'income', 'transfer', 'refund')), CHECK (review_status IN ('confirmed', 'needsReview')), CHECK (origin IN ('manual', 'auto'))) STRICT;"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\")) STRICT;"
        }
      ]
    },
    {
      "name": "raw_captures",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"raw_captures\" (\"id\" TEXT NOT NULL, \"content_hash\" TEXT NOT NULL UNIQUE, \"source\" TEXT NOT NULL, \"origin\" TEXT NULL, \"received_at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"drop_reason\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (source IN ('android_notification', 'android_sms', 'ios_shortcut', 'share', 'paste')), CHECK (status IN ('parsed', 'dropped', 'unparsed', 'duplicate'))) STRICT;"
        }
      ]
    },
    {
      "name": "transaction_sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transaction_sources\" (\"id\" TEXT NOT NULL, \"transaction_id\" TEXT NOT NULL REFERENCES transactions (id) ON DELETE CASCADE, \"raw_capture_id\" TEXT NOT NULL REFERENCES raw_captures (id) ON DELETE CASCADE, \"source\" TEXT NOT NULL, \"origin\" TEXT NULL, \"received_at\" INTEGER NOT NULL, \"raw_text\" TEXT NULL, \"parser_template_id\" TEXT NULL, \"confidence\" REAL NULL, PRIMARY KEY (\"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "unparsed",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"unparsed\" (\"id\" TEXT NOT NULL, \"raw_capture_id\" TEXT NOT NULL REFERENCES raw_captures (id) ON DELETE CASCADE, \"masked_text\" TEXT NOT NULL, \"received_at\" INTEGER NOT NULL, \"resolved_transaction_id\" TEXT NULL REFERENCES transactions (id) ON DELETE SET NULL, PRIMARY KEY (\"id\")) STRICT;"
        }
      ]
    },
    {
