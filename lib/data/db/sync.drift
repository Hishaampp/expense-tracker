-- Phase 9: every change to a synced table, made on this phone while sync is
-- on, queues its record for upload. Changes applied from the server set the
-- `applying` flag and are not queued again. Message text tables
-- (raw_captures, transaction_sources, unparsed) are never synced.
import 'tables.dart';

CREATE TRIGGER sync_accounts_insert AFTER INSERT ON accounts
  WHEN EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'enabled') AND NOT EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'applying')
BEGIN
  INSERT OR REPLACE INTO sync_outbox (record_table, record_key, changed_at)
  VALUES ('accounts', NEW.id, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
END;

CREATE TRIGGER sync_accounts_update AFTER UPDATE ON accounts
  WHEN EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'enabled') AND NOT EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'applying')
BEGIN
  INSERT OR REPLACE INTO sync_outbox (record_table, record_key, changed_at)
  VALUES ('accounts', NEW.id, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
END;

CREATE TRIGGER sync_accounts_delete AFTER DELETE ON accounts
  WHEN EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'enabled') AND NOT EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'applying')
BEGIN
  INSERT OR REPLACE INTO sync_outbox (record_table, record_key, changed_at)
  VALUES ('accounts', OLD.id, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
END;

