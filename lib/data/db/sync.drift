CREATE TRIGGER sync_settings_insert AFTER INSERT ON settings
  WHEN EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'enabled') AND NOT EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'applying') AND NEW."key" IN ('month_start_day', 'watch_category')
BEGIN
  INSERT OR REPLACE INTO sync_outbox (record_table, record_key, changed_at)
  VALUES ('settings', NEW.key, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
END;

CREATE TRIGGER sync_settings_update AFTER UPDATE ON settings
  WHEN EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'enabled') AND NOT EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'applying') AND NEW."key" IN ('month_start_day', 'watch_category')
BEGIN
  INSERT OR REPLACE INTO sync_outbox (record_table, record_key, changed_at)
  VALUES ('settings', NEW.key, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
END;

CREATE TRIGGER sync_settings_delete AFTER DELETE ON settings
  WHEN EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'enabled') AND NOT EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'applying') AND OLD."key" IN ('month_start_day', 'watch_category')
BEGIN
  INSERT OR REPLACE INTO sync_outbox (record_table, record_key, changed_at)
  VALUES ('settings', OLD.key, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
END;
