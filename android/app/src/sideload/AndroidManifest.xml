<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sideload flavor only (spec §6.2). The SMS receiver and history import
         arrive in Phase 3; permissions are declared here so the flavor split
         and the manifest gate are exercised from Phase 0. The `play` flavor
         must NEVER merge these — tool/check_manifests.sh enforces it. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
</manifest>
